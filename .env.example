# Copy to ~/workspace/agentgames/agent.env (mode 600) and fill in.
# NEVER commit real values. The server also reads real env vars (which win).
AGENT_GAMES_HMAC_SECRET=
KURIER_API_KEY=
# Free Pinggy account token — WITHOUT it the tunnel expires every 60 minutes
# and the public URL rotates. With it, the tunnel stays up indefinitely.
PINGGY_TOKEN=
PORT=3000
